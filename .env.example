# Environment Variables Template
# Copy this file to .env.prod and fill in your actual values

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://your-database-host:3306/your-database?useSSL=true&requireSSL=true&verifyServerCertificate=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Email Configuration
EMAIL_PASSWORD=your_email_password_here

# Recommendation Service
RECOMMENDATION_URL=http://localhost:8000/recommendations

# Server Configuration
SERVER_PORT=8080
